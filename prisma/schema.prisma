generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  passwordHash        String
  role                String        @default("STUDENT") // STUDENT, PARENT, STAFF, ADMIN
  firstName           String
  lastName            String
  phone               String?
  studentId           String?
  resetPasswordToken  String?       @unique
  resetPasswordExpiry DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  appointments Appointment[]
  auditLogs    AuditLog[]
}

model Appointment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose         String    // e.g. "Tuition Fee", "Miscellaneous", "Graduation Fee", "Clearance", "Scholarship Verification"
  appointmentDate DateTime
  timeSlot        String    // e.g. "09:00 AM - 09:30 AM"
  status          String    @default("CONFIRMED") // PENDING, CONFIRMED, CHECKED_IN, SERVING, COMPLETED, CANCELLED, MISSED
  qrToken         String    @unique // CSPRNG 32-byte hex token or signed payload
  isUsed          Boolean   @default(false)
  usedAt          DateTime?
  expiresAt       DateTime?
  queueNumber     Int?      // Daily queue number e.g. 101, 102
  counterName     String?   // Optional counter name e.g. "Counter 1", "Window 2"
  remarks         String?
  checkInTime     DateTime?
  servedTime      DateTime?
  completedTime   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // QR_GENERATED, QR_SCANNED_SUCCESS, QR_INVALID, TOKEN_VALIDATED, STATUS_CHANGE, etc.
  details   String   // JSON string with detailed event context
  ipAddress String?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
}

